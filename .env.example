# Video Editing Copilot - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
# Google Gemini API key (get one at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# AssemblyAI API key (alternative transcription service)
# ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# Gemini model to use. Keep this configurable as model availability evolves.
GEMINI_MODEL=gemini-2.5-flash
# Max characters of transcript sent to Gemini per request (~4000 ≈ 1000 tokens).
# Increase to 8000 on a paid plan for better accuracy on very long videos.
GEMINI_MAX_TRANSCRIPT_CHARS=4000

# Disk cache for Gemini analysis results (re-running the same video costs nothing).
# Set to 'off' to disable caching.
GEMINI_CACHE_DIR=./.cache/gemini

# ── Processing Defaults (can leave as-is) ─────────────────────────────────────
DEFAULT_CLIP_COUNT=5
DEFAULT_CLIP_LENGTH_MIN=30
DEFAULT_CLIP_LENGTH_MAX=60

# Output video dimensions (9:16 vertical for social media)
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30

# Directory paths
OUTPUT_DIR=./output
BRAND_KITS_PATH=./brand_kits.json
JOB_DATABASE_PATH=./.opuslabs/jobs.sqlite3
JOB_WORKSPACE_ROOT=./.opuslabs/workspaces
JOB_STALE_AFTER_SECONDS=3600
PUBLISH_DATABASE_PATH=./.opuslabs/publishing.sqlite3
PUBLISH_DRAFT_DIR=./.opuslabs/publishing/drafts
PUBLISH_CREDENTIAL_DIR=./.opuslabs/credentials
ANALYTICS_DATABASE_PATH=./.opuslabs/analytics.sqlite3
TEMP_DIR=./temp

# Whisper model size: tiny | base | small | medium | large
# Larger = more accurate but slower; 'base' is a good default
WHISPER_MODEL=base
